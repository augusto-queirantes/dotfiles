#!/usr/bin/env bash
# Applies the Maestri agent presets. Maestri keeps presets in its own store and
# syncs them between Macs; this is the record of what they should be. Run it
# from a Maestro terminal (the preset commands are Maestro only). Safe to rerun.
# Model, effort and permission mode come from ~/.claude/settings.json unless a
# preset's command overrides them.
set -euo pipefail

m="${MAESTRI_CLI:-maestri}"

# name|command ("" is a plain shell)
presets=(
  "Claude Code|claude"
  "Claude Light|claude --model sonnet --effort medium"
  "Claude Plan|claude --permission-mode plan"
  "Shell|"
  # conclave's roles. QA and Designer run in dontAsk with only their own skills
  # allowed: a skill's allowed-tools approve its commands while it runs and
  # anything else is refused, since a Bash(...) entry in a role's tools grants
  # all of Bash. Developer needs all of Bash.
  "Developer|claude --agent developer:developer"
  'QA|claude --agent qa:qa --permission-mode dontAsk --allowedTools "Skill(qa:tech)" "Skill(qa:user)" "Skill(qa:report)"'
  'Designer|claude --agent designer:designer --permission-mode dontAsk --allowedTools "Skill(designer:review)" "Skill(designer:contract)"'
  # The CTO is a Maestro: it makes a floor per task and recruits one Developer
  # there, with the commands below allowed one by one. It runs with the global
  # "CTO" Maestri role, which starts it in <workspace>/.maestri/roles/<id>, so
  # ../../.. is the workspace's directory. It always runs in auto mode, so it
  # can question you; the allow rules skip the classifier for the hand-off.
  'CTO|claude --agent cto:cto --permission-mode auto --add-dir ../../.. --allowedTools "Skill(cto:plan)" "Skill(cto:task)" "Skill(cto:assign)" "Skill(cto:validate)" "Skill(cto:move)" "Skill(cto:status)" "Skill(maestri)" "Skill(maestri-chat)" "Skill(maestri-manager)" "Skill(maestri-workspace)" "Bash(maestri list)" "Bash(maestri floor list)" "Bash(maestri floor status *)" "Bash(maestri floor create *)" "Bash(maestri recruit *)" "Bash(maestri ask *)" "Bash(maestri check *)" "Bash(maestri note create *)" "Bash(maestri note read *)" "Bash(maestri note write *)" "Bash(maestri notify *)" "Bash(maestri say *)" "Bash(maestri recall *)" "Bash(git -C * fetch origin *)" "Bash(ls *)" "Bash(git -C * worktree add *)"'
)

# Presets that run in Maestro mode.
maestros=("CTO")

# Maestri ships the first three; the agents here run on Claude Code only.
# Project Manager is the CTO's former name.
unused=("Codex" "Antigravity" "OpenCode" "Project Manager")

for entry in "${presets[@]}"; do
  name="${entry%%|*}"
  cmd="${entry#*|}"
  maestro=off
  [[ " ${maestros[*]} " == *" $name "* ]] && maestro=on
  args=(--maestro "$maestro" --chat off --quick-start on)
  [[ -n "$cmd" ]] && args+=(--command "$cmd")
  if "$m" preset show "$name" >/dev/null 2>&1; then
    "$m" preset set "$name" "${args[@]}"
  else
    "$m" preset create "$name" "${args[@]}"
  fi
done

for name in "${unused[@]}"; do
  if "$m" preset show "$name" >/dev/null 2>&1; then
    "$m" preset delete "$name"
  fi
done

"$m" preset list
