{
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch",
      "Bash(semble *)",
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(bat *)",
      "Bash(jq *)",
      "Bash(curl -sL *)",
      "Bash(curl -fsSL *)",
      "Bash(gh *)",
      "mcp__semble__search",
      "mcp__semble__find_related",
      "Bash(maestri *)",
      "Bash(vercel ls*)",
      "Bash(vercel list*)",
      "Bash(vercel inspect *)",
      "Bash(vercel logs *)",
      "Bash(vercel whoami)",
      "Bash(vercel env ls*)",
      "Bash(vercel project ls*)",
      "Bash(vercel deploy*)",
      "Bash(supabase projects list*)",
      "Bash(supabase status*)",
      "Bash(supabase migration list*)",
      "Bash(supabase inspect *)",
      "Bash(supabase db diff*)",
      "Bash(supabase gen types *)"
    ],
    "deny": [
      "Bash(git push)",
      "Bash(git push*origin)",
      "Bash(git push* HEAD*)",
      "Bash(git push* main)",
      "Bash(git push* main *)",
      "Bash(git push*:main)",
      "Bash(git push*:main *)",
      "Bash(git push* --force)",
      "Bash(git push* --force *)",
      "Bash(git push* -f)",
      "Bash(git push* -f *)",
      "Bash(git push* +*)",
      "Bash(git push*--no-verify*)",
      "Bash(*hook.protect-main*)",
      "Bash(*hook.pre-push.enabled*)",
      "Bash(gh pr merge*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo edit*--visibility*)",
      "Bash(gh release delete*)",
      "Bash(gh secret delete*)",
      "Bash(gh variable delete*)",
      "Bash(gh api*-X DELETE*)",
      "Bash(gh api*--method DELETE*)",
      "Bash(vercel remove*)",
      "Bash(vercel rm*)",
      "Bash(vercel project rm*)",
      "Bash(vercel project remove*)",
      "Bash(vercel domains rm*)",
      "Bash(vercel domains remove*)",
      "Bash(vercel dns rm*)",
      "Bash(vercel dns remove*)",
      "Bash(vercel env rm*)",
      "Bash(vercel env remove*)",
      "Bash(supabase projects delete*)",
      "Bash(supabase db reset*)",
      "Bash(supabase branches delete*)",
      "Bash(supabase functions delete*)",
      "Bash(supabase storage rm*)",
      "Bash(dropdb*)",
      "Bash(*DROP DATABASE*)",
      "Bash(*drop database*)",
      "Bash(*DROP SCHEMA*)",
      "Bash(*drop schema*)",
      "Bash(*DROP TABLE*)",
      "Bash(*drop table*)",
      "Bash(*TRUNCATE *)",
      "Bash(*truncate table*)"
    ],
    "ask": [
      "Bash(git push* --delete *)",
      "Bash(git push* -d *)",
      "Bash(gh secret set*)",
      "Bash(gh variable set*)",
      "Bash(vercel*--prod*)",
      "Bash(vercel promote*)",
      "Bash(vercel rollback*)",
      "Bash(vercel redeploy*)",
      "Bash(vercel alias*)",
      "Bash(vercel link*)",
      "Bash(vercel pull*)",
      "Bash(vercel env add*)",
      "Bash(vercel env update*)",
      "Bash(vercel env pull*)",
      "Bash(npx vercel*)",
      "Bash(bunx vercel*)",
      "Bash(supabase link*)",
      "Bash(supabase db push*)",
      "Bash(supabase db pull*)",
      "Bash(supabase db dump*)",
      "Bash(supabase migration up*)",
      "Bash(supabase migration repair*)",
      "Bash(supabase secrets*)",
      "Bash(supabase config push*)",
      "Bash(supabase functions deploy*)",
      "Bash(npx supabase*)",
      "Bash(bunx supabase*)",
      "Bash(psql*supabase*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0
  },
  "enabledPlugins": {
    "ruby-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "engineer@conclave": true,
    "datadog@claude-plugins-official": true,
    "architect@conclave": true,
    "qa@conclave": true,
    "ship@conclave": true,
    "house@conclave": true
  },
  "extraKnownMarketplaces": {
    "conclave": {
      "source": {
        "source": "github",
        "repo": "augusto-queirantes/conclave"
      },
      "autoUpdate": true
    }
  },
  "sandbox": {
    "enabled": true,
    "credentials": {
      "files": [
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.aws/credentials",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": ["gh *", "docker *"],
    "network": {
      "allowAllUnixSockets": true,
      "allowLocalBinding": true,
      "allowedDomains": [
        "linhaai.com.br",
        "www.linhaai.com.br",
        "fonts.googleapis.com",
        "fonts.gstatic.com"
      ]
    }
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "askUserQuestionTimeout": "never",
  "tui": "fullscreen",
  "autoMemoryEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark-daltonized",
  "editorMode": "vim",
  "verbose": false,
  "preferredNotifChannel": "auto",
  "autoContinueAtUsageLimit": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "autoMode": {
    "allow": [
      "Read-only inspection anywhere on this machine: listing files, reading source, `git log` / `git diff` / `git status`, `rg` / `fd` / `bat` / `jq`, and `gh api GET` requests.",
      "Any edit, build, test, lint, or format command scoped to files inside the git repo the session is working in.",
      "Local dev-environment management that touches only this machine's own tooling: `stow`, `brew bundle`, `mise`, `tmux`, and re-running install scripts from the trusted repo.",
      "Creating branches, staging, and committing in any repo."
    ],
    "soft_deny": [
      "Any write to a shell rc file (`.zshrc`, `.zshenv`, `.zprofile`) — these change what future sessions are permitted to do, so they stay a manual step."
    ],
    "hard_deny": [
      "Writing credentials, tokens, API keys, or any content read from `~/.zshenv.local`, `~/.ssh`, or `~/.aws` into the trusted repo — it is public (github.com/augusto-queirantes/dotfiles).",
      "Sending repo contents, file listings, or command output to public paste, gist, or snippet services."
    ]
  },
  "outputStyle": "Simpler Answers"
}
